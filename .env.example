# Copy to .env at repo root:  cp .env.example .env
# Docker Compose reads this file for variable substitution and passes values into containers.

# --- PostgreSQL (host port when running compose; DB is also reachable as hostname `postgres` from API) ---
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# API database (migrations, seed, runtime). Set DB_SSL=true for Supabase / managed Postgres.
#
# Option A — Supabase (recommended for `docker compose up` without local Postgres):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#   DB_SSL=true
#
# Option B — bundled Postgres (run: docker compose --profile local-db up --build):
DATABASE_URL=postgres://taskflow:taskflow@postgres:5432/taskflow
DB_SSL=false

# --- API ---
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRY=86400
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:3000

# Browser calls this URL (your machine’s localhost, not the `api` service hostname)
VITE_API_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
